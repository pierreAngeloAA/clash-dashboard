# Imagen de desarrollo. El Dockerfile de al lado es el que genera Rails para
# produccion (multi-stage, usuario sin privilegios, Thruster) y no sirve aqui:
# omite el grupo `development` del Gemfile, con lo que no habria rspec ni debug.
ARG RUBY_VERSION=3.3.5
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

ENV RAILS_ENV="development" \
    BUNDLE_PATH="/usr/local/bundle"

# build-essential y libpq-dev compilan la gema pg; postgresql-client trae psql
# y pg_isready para depurar la conexion desde dentro del contenedor.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential git libpq-dev libyaml-dev pkg-config postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

EXPOSE 3000

# El pid queda huerfano si el contenedor muere sin limpiar, y al siguiente
# arranque Puma se niega a levantar creyendo que ya hay un server vivo.
# db:prepare crea la base y corre las migraciones pendientes; es idempotente,
# asi que un `docker compose up` repetido no rompe nada.
CMD ["bash", "-c", "rm -f tmp/pids/server.pid && ./bin/rails db:prepare && ./bin/rails server -b 0.0.0.0 -p 3000"]
